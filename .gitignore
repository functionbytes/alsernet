vendor/
# Excepcion: las librerias de terceros que un modulo publica junto a sus assets
# (interact.js del editor de PriceLabels) viven en un js/vendor/ y si van al
# repo; si no, cualquier despliegue se queda sin ellas y la vista no funciona.
!modules/*/public/**/vendor/
!public/modules/*/**/vendor/
# Excepcion: los assets publicados del propio Helpdesk (core y satelites) viven
# en public/vendor/helpdesk*/ por convencion del proyecto, no son un vendor de
# terceros — sin esto, archivos nuevos ahi quedan silenciosamente fuera del repo.
# Git no permite re-incluir un hijo de un directorio ya excluido (aqui,
# "public/vendor" cae bajo la regla "vendor/" de la linea 1), asi que hace
# falta des-excluir el propio public/vendor/ primero y volver a excluir todo
# lo que no sea helpdesk*/ (p.ej. leaflet/, scribe/, que si son de terceros).
!public/vendor/
public/vendor/*
!public/vendor/helpdesk*/
node_modules/
stubs/

bootstrap/compiled.php
bootstrap/cache/

public/storage
public/hot
public_html/storage
public_html/hot
public/build
public/storage

/storage/
/storage/pail
storage/*.key

.env
.env.backup
.env.production
.phpactor.json

# Logs & caches
*.log
*.cache
*.txt

# IDE & OS
.DS_Store

# Claude Code & Development Tools
.claude/
.tinker/
.idea/
.vscode/

# Composer
composer.lock
composer.phar

# NPM/Yarn
package-lock.json
yarn.lock

# Dumps / backups
*.sql
*.sql.gz
*.zip
*.tar
*.tar.gz
*.gz
*.md

# Temporary files
tmp/
temp/
*.tmp
EOF
