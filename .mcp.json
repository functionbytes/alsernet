{
  "mcpServers": {
    "laravel-boost": {
      "command": "php",
      "args": [
        "artisan",
        "boost:mcp"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "--yes",
        "@upstash/context7-mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "--yes",
        "chrome-devtools-mcp",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ],
      "_isolation_note": "Para sesiones independientes usar isolatedContext en new_page, ej: {url, isolatedContext: 'testing-users'} — cada contexto tiene cookies/storage propios"
    }
  }
}
