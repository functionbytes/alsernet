# ========================================
# APPLICATION CONFIGURATION
# ========================================
APP_NAME="InoqualabSystem"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Comma-separated list of allowed CORS origins (defaults to APP_URL if empty)
CORS_ALLOWED_ORIGINS=

# Localization
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Maintenance & Cleanup
APP_MAINTENANCE_DRIVER=file
CMS_ENABLED_CLEANUP_DATABASE=true
DEFAULT_PAGINATION=30

# Security
BCRYPT_ROUNDS=12

# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inoqualab
DB_USERNAME=root
DB_PASSWORD=

# ========================================
# LOGGING
# ========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ========================================
# SESSION CONFIGURATION
# ========================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Set to true in production (requires HTTPS). Do NOT use false on production.
SESSION_SECURE_COOKIE=true

# ========================================
# CACHE & QUEUE
# ========================================
CACHE_STORE=redis
CACHE_PREFIX=inoqualabs_

QUEUE_CONNECTION=redis
QUEUE_NAME=default
QUEUE_RETRY_AFTER=90

FILESYSTEM_DISK=local

# ========================================
# BROADCASTING
# ========================================
BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb

# Laravel Reverb Configuration
REVERB_APP_ID=123456
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Vite Broadcasting
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ========================================
# MEMCACHED CONFIGURATION
# ========================================
MEMCACHED_HOST=127.0.0.1

# ========================================
# MAIL CONFIGURATION
# ========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin email for critical error notifications (500 errors)
ADMIN_EMAIL=

# Backup notification recipient (defaults to MAIL_FROM_ADDRESS if not set)
BACKUP_NOTIFICATION_EMAIL=
BACKUP_SLACK_WEBHOOK=
BACKUP_DISCORD_WEBHOOK=

# Mailrelay API credentials and newsletter settings
MAILRELAY_API_KEY=
MAILRELAY_HOST=account.ipzmarketing.com
MAILRELAY_NEWSLETTER_GROUP_ID=
# Mailrelay webhook token (used to verify incoming webhook requests)
MAILRELAY_WEBHOOK_TOKEN=

# Mailjet (Optional)
MAILJET_APIKEY=
MAILJET_APISECRET=

# Firebase Cloud Messaging v1 (Push Notifications)
# Descargar desde Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# ========================================
# AWS CONFIGURATION (Optional)
# ========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ========================================
# API CONFIGURATION
# ========================================
API_VERSION=v1
API_RATE_LIMIT_PUBLIC=20
API_RATE_LIMIT_AUTH=100
API_RATE_LIMIT_ADMIN=500
API_PER_PAGE=15
API_MAX_PER_PAGE=100

# ========================================
# APPLICATION FEATURES
# ========================================
APP_BRAND=false
APP_SAAS=true
APP_CARTPAYE=false

# ========================================
# ENCRYPTION & SECURITY
# ========================================
# Generate with: php artisan key:generate
ENCRYPTION_SECRET=

# JWT Authentication
# Generate with: php artisan jwt:secret
JWT_SECRET=

# ========================================
# SANCTUM CONFIGURATION
# ========================================
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ========================================
# MONITORING (Telescope, Pulse, Horizon)
# ========================================
TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope

PULSE_ENABLED=true
PULSE_DOMAIN=
PULSE_PATH=pulse

HORIZON_NAME=inoqualabs
HORIZON_PATH=horizon
HORIZON_NOTIFICATION_EMAIL=

# Error alert throttle in seconds (default: 5 minutes)
ERROR_ALERT_THROTTLE=300
# Alert when this many jobs have failed in the queue
FAILED_JOB_ALERT_THRESHOLD=10

# ========================================
# SENTRY ERROR TRACKING
# ========================================
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ========================================
# PAGES MODULE
# ========================================
PAGE_CACHE_ENABLED=true
PAGE_CACHE_TTL=1440
PAGE_CACHE_DRIVER=redis
PAGE_VIEWS_RETENTION_DAYS=90
PAGE_NOTIFY_ON_PUBLISH=false
PAGE_NOTIFY_EMAILS=admin@example.com,editor@example.com
PAGE_NOTIFY_SUBSCRIBERS=false
PAGE_SOCIAL_SHARE=true

# ========================================
# AI INTEGRATIONS
# ========================================
ANTHROPIC_API_KEY=

# DeepL Translation API
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

# Google APIs
GOOGLE_PAGESPEED_KEY=

# ========================================
# EXTERNAL INTEGRATIONS
# ========================================

# ERP Integration
ERP_URL=

# Document Upload Portal
DOCUMENTS_UPLOAD_PORTAL_URL=

# Minderest Integration
MINDEREST_URL=

# PrestaShop Integration
PRESTASHOP_ENABLED=false
DOCUMENTS_PRESTASHOP_PAID_STATUS_IDS=

# ========================================
# N8N WORKFLOW AUTOMATION (Optional)
# ========================================
N8N_API_URL=
N8N_API_KEY=

# ========================================
# MCP FILESYSTEM (Optional)
# ========================================
MCP_FILESYSTEM_ROOT=/path/to/your/project

# ========================================
# VITE FRONTEND
# ========================================
VITE_APP_NAME="${APP_NAME}"

# ========================================
# HELPDESK MODULE
# ========================================
HELPDESK_SLA_TIMEZONE=America/New_York
HELPDESK_FROM_EMAIL=
HELPDESK_FROM_NAME=
HELPDESK_QUEUE=default
HELPDESK_NOTIFICATIONS_QUEUE=notifications
HELPDESK_SCHEDULED_QUEUE=helpdesk-scheduled
HELPDESK_HEAVY_QUEUE=helpdesk-heavy
HELPDESK_WEBHOOKS_QUEUE=helpdesk-webhooks
HELPDESK_AUTO_RESPONSE_HOURS=8
HELPDESK_PORTAL_ENABLED=true
HELPDESK_PORTAL_TOKEN_EXPIRY=24
HELPDESK_IMAP_ENABLED=false
HELPDESK_IMAP_SERVER=
HELPDESK_IMAP_PORT=993
HELPDESK_IMAP_USERNAME=
HELPDESK_IMAP_PASSWORD=
HELPDESK_IMAP_FOLDER=INBOX

# Helpdesk Social Integrations (configure when ready)
WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
FACEBOOK_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
INSTAGRAM_ENABLED=false
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# ========================================
# SETUP INSTRUCTIONS
# ========================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate application key: php artisan key:generate
# 3. Generate JWT secret: php artisan jwt:secret
# 4. Configure database credentials above
# 5. Run migrations: php artisan migrate
# 6. Seed database: php artisan db:seed
# 7. Install CMS modules: php artisan cms:install --seed
# 8. Start queue worker: php artisan queue:work
# 9. Start Reverb server: php artisan reverb:start
# 10. Start development server: php artisan serve
