# ========================================
# APPLICATION CONFIGURATION
# ========================================
APP_NAME="InoqualabSystem"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Localization
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Maintenance & Cleanup
APP_MAINTENANCE_DRIVER=file
CMS_ENABLED_CLEANUP_DATABASE=true
DEFAULT_PAGINATION=30

# Security
BCRYPT_ROUNDS=12

# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inoqualab
DB_USERNAME=root
DB_PASSWORD=

# ========================================
# LOGGING
# ========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ========================================
# SESSION CONFIGURATION
# ========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# ========================================
# CACHE & QUEUE
# ========================================
CACHE_DRIVER=file
CACHE_STORE=file
CACHE_PREFIX=

QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# ========================================
# BROADCASTING
# ========================================
BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb

# Laravel Reverb Configuration
REVERB_APP_ID=123456
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Vite Broadcasting
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ========================================
# MEMCACHED CONFIGURATION
# ========================================
MEMCACHED_HOST=127.0.0.1

# ========================================
# MAIL CONFIGURATION
# ========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailjet (Optional)
MAILJET_APIKEY=
MAILJET_APISECRET=

# ========================================
# AWS CONFIGURATION (Optional)
# ========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ========================================
# APPLICATION FEATURES
# ========================================
APP_BRAND=false
APP_SAAS=true
APP_CARTPAYE=false

# ========================================
# ENCRYPTION & SECURITY
# ========================================
# Generate with: php artisan key:generate
ENCRYPTION_SECRET=

# JWT Authentication
# Generate with: php artisan jwt:secret
JWT_SECRET=

# ========================================
# SANCTUM CONFIGURATION
# ========================================
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ========================================
# TELESCOPE MONITORING (Optional)
# ========================================
TELESCOPE_ENABLED=false

# ========================================
# PULSE MONITORING (Optional)
# ========================================
PULSE_ENABLED=false

# ========================================
# EXTERNAL INTEGRATIONS
# ========================================

# ERP Integration
ERP_URL=

# Document Upload Portal
DOCUMENTS_UPLOAD_PORTAL_URL=

# Minderest Integration
MINDEREST_URL=

# PrestaShop Integration
PRESTASHOP_ENABLED=false
DOCUMENTS_PRESTASHOP_PAID_STATUS_IDS=

# ========================================
# N8N WORKFLOW AUTOMATION (Optional)
# ========================================
N8N_API_URL=
N8N_API_KEY=

# ========================================
# MCP FILESYSTEM (Optional)
# ========================================
MCP_FILESYSTEM_ROOT=/path/to/your/project

# ========================================
# VITE FRONTEND
# ========================================
VITE_APP_NAME="${APP_NAME}"

# ========================================
# SETUP INSTRUCTIONS
# ========================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate application key: php artisan key:generate
# 3. Generate JWT secret: php artisan jwt:secret
# 4. Configure database credentials above
# 5. Run migrations: php artisan migrate
# 6. Seed database: php artisan db:seed
# 7. Install CMS modules: php artisan cms:install --seed
# 8. Start queue worker: php artisan queue:work
# 9. Start Reverb server: php artisan reverb:start
# 10. Start development server: php artisan serve
