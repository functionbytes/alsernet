# ===========================================================================
# E2E staging — env del panel Laravel (contenedor `panel`).
# Basado en docker/laravel.env pero autocontenido: BD MariaDB propia del
# compose, sin Redis/Reverb/Oracle/servicios externos.
#
# El secreto ALSERNETBRIDGE_WEBHOOK_SECRET debe coincidir con la fila de
# aalv_configuration en fixtures/20-bridge-data.sql y con el default de
# run-contract-e2e.sh — rotar los tres a la vez.
# ===========================================================================

APP_NAME="Alsernet Panel E2E"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8094
APP_KEY=base64:uw9ildLKily5v0ZHlv0d84JMx/VpqR/kPIf9tCh+ZKA=

TELESCOPE_ENABLED=false
HELPDESK_AI_ENABLED=false

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=root
DB_PASSWORD=e2e-root-secret

DB_CONNECTION_HELPDESK=mysql
DB_HOST_HELPDESK=db
DB_PORT_HELPDESK=3306
DB_DATABASE_HELPDESK=panel
DB_USERNAME_HELPDESK=root
DB_PASSWORD_HELPDESK=e2e-root-secret

# Conexiones secundarias que algunos módulos referencian por nombre de BD
DB_DATABASE_PRESTASHOP=bridge
DB_DATABASE_WEBADMIN=panel

# Drivers autocontenidos: nada de Redis/Reverb en este compose
CACHE_STORE=file
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log
MAIL_MAILER=log

# --- Integración HelpdeskPrestashop -> bridge stub ---
ALSERNETBRIDGE_API_URL=http://bridge/modules/alsernetbridge/api.php
ALSERNETBRIDGE_WEBHOOK_SECRET=e2e5ecb2f4b4d0f9a3c1d2e3f405162738495a6b7c8d9e0f1a2b3c4d5e6f7081
# BD PrestaShop de solo lectura usada por el banco de pruebas del helpdesk
HELPDESK_PS_DB=bridge
