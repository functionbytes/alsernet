{
    "openapi": "3.0.0",
    "info": {
        "title": "Alsernet Ecommerce API",
        "description": "API REST de la plataforma Ecommerce. Endpoints públicos y autenticados con Sanctum.",
        "version": "1.0.0",
        "contact": {
            "email": "info@example.com"
        }
    },
    "servers": [
        {
            "url": "/",
            "description": "API Server"
        }
    ],
    "tags": [
        {"name": "Productos", "description": "Catálogo de productos"},
        {"name": "Carrito", "description": "Operaciones de carrito"},
        {"name": "Órdenes", "description": "Gestión de órdenes (autenticado)"},
        {"name": "Cliente", "description": "Perfil del cliente (autenticado)"},
        {"name": "Wishlist", "description": "Lista de deseos (autenticado)"},
        {"name": "Locations", "description": "Países, estados, ciudades"},
        {"name": "Newsletter", "description": "Suscripción al newsletter"}
    ],
    "paths": {
        "/api/v1/ecommerce/products": {
            "get": {
                "tags": ["Productos"],
                "summary": "Listar productos",
                "parameters": [
                    {"name": "q", "in": "query", "description": "Búsqueda por nombre o SKU", "schema": {"type": "string"}},
                    {"name": "per_page", "in": "query", "description": "Items por página", "schema": {"type": "integer", "default": 12}}
                ],
                "responses": {"200": {"description": "Listado de productos paginado"}}
            }
        },
        "/api/v1/ecommerce/products/suggestions": {
            "get": {
                "tags": ["Productos"],
                "summary": "Autocomplete de productos",
                "parameters": [
                    {"name": "q", "in": "query", "required": true, "description": "Texto a buscar (min 2 chars)", "schema": {"type": "string"}}
                ],
                "responses": {"200": {"description": "Lista de sugerencias hasta 8 productos"}}
            }
        },
        "/api/v1/ecommerce/cart": {
            "get": {
                "tags": ["Carrito"],
                "summary": "Obtener carrito actual",
                "responses": {"200": {"description": "Items del carrito"}}
            },
            "post": {
                "tags": ["Carrito"],
                "summary": "Agregar producto al carrito",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["product_id"],
                                "properties": {
                                    "product_id": {"type": "integer"},
                                    "qty": {"type": "integer", "default": 1}
                                }
                            }
                        }
                    }
                },
                "responses": {"200": {"description": "Producto agregado"}}
            }
        },
        "/api/v1/ecommerce/cart/count": {
            "get": {
                "tags": ["Carrito"],
                "summary": "Contador de items en carrito",
                "responses": {"200": {"description": "{count: int}"}}
            }
        },
        "/api/v1/ecommerce/cart/{rowId}": {
            "put": {
                "tags": ["Carrito"],
                "summary": "Actualizar cantidad de un item",
                "parameters": [{"name": "rowId", "in": "path", "required": true, "schema": {"type": "string"}}],
                "responses": {"200": {"description": "Carrito actualizado"}}
            },
            "delete": {
                "tags": ["Carrito"],
                "summary": "Eliminar item del carrito",
                "parameters": [{"name": "rowId", "in": "path", "required": true, "schema": {"type": "string"}}],
                "responses": {"200": {"description": "Item eliminado"}}
            }
        },
        "/api/v1/ecommerce/orders": {
            "get": {
                "tags": ["Órdenes"],
                "summary": "Listar órdenes del cliente autenticado",
                "security": [{"sanctum": []}],
                "responses": {"200": {"description": "Listado de órdenes"}}
            },
            "post": {
                "tags": ["Órdenes"],
                "summary": "Crear orden (idempotente)",
                "security": [{"sanctum": []}],
                "parameters": [
                    {"name": "Idempotency-Key", "in": "header", "description": "Clave única para idempotencia", "schema": {"type": "string"}}
                ],
                "responses": {
                    "201": {"description": "Orden creada"},
                    "422": {"description": "Validación"}
                }
            }
        },
        "/api/v1/ecommerce/profile": {
            "get": {
                "tags": ["Cliente"],
                "summary": "Perfil del cliente",
                "security": [{"sanctum": []}],
                "responses": {"200": {"description": "Datos del cliente"}}
            },
            "put": {
                "tags": ["Cliente"],
                "summary": "Actualizar perfil",
                "security": [{"sanctum": []}],
                "responses": {"200": {"description": "Perfil actualizado"}}
            }
        },
        "/api/v1/ecommerce/wishlist": {
            "get": {
                "tags": ["Wishlist"],
                "summary": "Lista de deseos del cliente",
                "security": [{"sanctum": []}],
                "responses": {"200": {"description": "Productos en wishlist"}}
            },
            "post": {
                "tags": ["Wishlist"],
                "summary": "Agregar a wishlist",
                "security": [{"sanctum": []}],
                "responses": {"201": {"description": "Agregado"}}
            }
        },
        "/api/v1/ecommerce/countries": {
            "get": {
                "tags": ["Locations"],
                "summary": "Listar países",
                "responses": {"200": {"description": "Lista de países activos"}}
            }
        },
        "/api/v1/ecommerce/filters": {
            "get": {
                "tags": ["Productos"],
                "summary": "Filtros disponibles para el catálogo",
                "responses": {"200": {"description": "Marcas, categorías y rango de precios"}}
            }
        },
        "/api/v1/ecommerce/coupons/apply": {
            "post": {
                "tags": ["Carrito"],
                "summary": "Aplicar cupón al carrito",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["code"],
                                "properties": {"code": {"type": "string"}}
                            }
                        }
                    }
                },
                "responses": {
                    "200": {"description": "Cupón aplicado"},
                    "404": {"description": "Cupón no encontrado"}
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "Sanctum"
            }
        }
    }
}
