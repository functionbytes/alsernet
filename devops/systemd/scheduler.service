[Unit]
Description=Laravel Scheduler
After=network.target
Requires=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home2/webadminpruebas/web
ExecStart=/bin/bash /home2/webadminpruebas/web/deployment/scripts/scheduler.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=laravel-scheduler
Environment="HOME=/var/www"
Environment="LARAVEL_ENV=production"

# Security settings
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=partial
ProtectHome=yes

# Resource limits
LimitNOFILE=65535
LimitNPROC=65535

[Install]
WantedBy=multi-user.target
