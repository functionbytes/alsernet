{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "aerni/cloudflared": "^1.1",
        "guzzlehttp/psr7": "2.7",
        "laravel/framework": "^12.0",
        "laravel/mcp": "^0.5.1",
        "pragmarx/google2fa-laravel": "^3.0",
        "pragmarx/google2fa-qrcode": "^3.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.6",
        "league/csv": "^9.21",
        "nesbot/carbon": "^3.8",
        "nwidart/laravel-modules": "^12.0",
        "phpoffice/phpspreadsheet": "^1.30",
        "pragmarx/google2fa": "^9.0",
        "ramsey/uuid": "^4.7",
        "spatie/image-optimizer": "^1.8",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/simple-excel": "^3.9",
        "symfony/finder": "^7.2",
        "symfony/mime": "^7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "1.8.9",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Spatie\\MediaLibrary\\": "modules/Media/vendor/spatie/laravel-medialibrary/src/",
            "Spatie\\Activitylog\\": "modules/Activity/vendor/spatie/laravel-activitylog/src/",
            "Laravel\\Pulse\\": "modules/Pulse/vendor/laravel/pulse/src/",
            "Laravel\\Telescope\\": "modules/Telescope/vendor/laravel/telescope/src/",
            "Modules\\Activity\\": "modules/Activity/app/",
            "Modules\\Auth\\": "modules/Auth/app/",
            "Modules\\Backup\\": "modules/Backup/app/",
            "Modules\\Core\\": "modules/Core/app/",
            "Modules\\Database\\": "modules/Database/app/",
            "Modules\\Document\\": "modules/Document/app/",
            "Modules\\Erp\\": "modules/Erp/app/",
            "Modules\\GiftMessage\\": "modules/GiftMessage/app/",
            "Modules\\GiftMessage\\Database\\Factories\\": "modules/GiftMessage/database/factories/",
            "Modules\\GiftMessage\\Database\\Seeders\\": "modules/GiftMessage/database/seeders/",
            "Modules\\Health\\": "modules/Health/app/",
            "Modules\\Helpdesk\\": "modules/Helpdesk/app/",
            "Modules\\Helpdesk\\Database\\Factories\\": "modules/Helpdesk/database/factories/",
            "Modules\\Helpdesk\\Database\\Seeders\\": "modules/Helpdesk/database/seeders/",
            "Modules\\Locales\\": "modules/Locales/app/",
            "Modules\\Mailer\\": "modules/Mailer/app/",
            "Modules\\MailsSettings\\": "modules/MailsSettings/app/",
            "Modules\\Media\\": "modules/Media/app/",
            "Modules\\Modules\\": "modules/Modules/app/",
            "Modules\\Notification\\": "modules/Notification/app/",
            "Modules\\PriceLabels\\": "modules/PriceLabels/app/",
            "Modules\\PriceLabels\\Database\\Factories\\": "modules/PriceLabels/database/factories/",
            "Modules\\PriceLabels\\Database\\Seeders\\": "modules/PriceLabels/database/seeders/",
            "Modules\\Pulse\\": "modules/Pulse/app/",
            "Modules\\Queue\\": "modules/Queue/app/",
            "Modules\\Role\\": "modules/Role/app/",
            "Modules\\Storage\\": "modules/Storage/app/",
            "Modules\\Supplier\\": "modules/Supplier/app/",
            "Modules\\System\\": "modules/System/app/",
            "Modules\\Telescope\\": "modules/Telescope/app/",
            "Modules\\Theme\\": "modules/Theme/app/",
            "Modules\\User\\": "modules/User/app/"
        },
        "files": [
            "app/Helpers/Helper.php",
            "modules/System/app/Helpers/SettingsHelper.php",
            "modules/System/app/Helpers/EnvironmentHelper.php",
            "modules/Core/app/Helpers/DateHelper.php",
            "modules/Core/app/Helpers/LocalizationHelper.php",
            "modules/Core/app/Helpers/DataFormatHelper.php",
            "modules/Core/app/Helpers/UrlValidationHelper.php",
            "modules/Core/app/Helpers/RateLimitHelper.php",
            "modules/Core/app/Helpers/SiteHelper.php",
            "modules/Core/app/Helpers/SecretHelper.php",
            "modules/Database/app/Helpers/QueryHelper.php",
            "modules/Storage/app/Helpers/PathHelper.php",
            "modules/Role/app/Helpers/PermissionHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "app/Helpers/Helper.php"
        ]
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "docs": [
            "@php artisan docs:generate-commands"
        ],
        "setup:hooks": [
            "bash manual/setup-hooks.sh"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "modules/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": true,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-scripts": false
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
