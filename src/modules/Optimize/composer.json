{
    "name": "modules/optimize",
    "description": "HTML optimization: minify, collapse whitespace, defer JS, remove comments",
    "type": "laravel-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Alsernet Development",
            "email": "dev@alsernet.com"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Optimize\\Providers\\OptimizeServiceProvider"
            ],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Optimize\\": "app/",
            "Modules\\Optimize\\Database\\Factories\\": "database/factories/",
            "Modules\\Optimize\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Optimize\\Tests\\": "tests/"
        }
    }
}
