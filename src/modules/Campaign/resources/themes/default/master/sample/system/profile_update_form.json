{
    "theme": "default",
    "name": "PageElement",
    "template": "Page",
    "formats": {
        "background_color": "#F4F4F4",
        "padding_top": 40,
        "padding_right": 60,
        "padding_bottom": 40,
        "padding_left": 60
    },
    "page_title": "Manage Your Subscription Preferences",
    "blocks": [
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 40
            },
            "elements": [
                {
                    "name": "HeadingElement",
                    "template": "Heading",
                    "formats": {},
                    "type": "h1",
                    "text": "Manage Your Subscription Preferences"
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{LIST_NAME}}"
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{CURRENT_DATE}}"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 0,
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "DividerElement",
                    "template": "Divider",
                    "formats": {
                        "background_color": "#D0D0D0",
                        "height": 2,
                        "divider_style": "solid",
                        "padding_top": 10,
                        "padding_bottom": 10
                    }
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "HeadingElement",
                    "template": "Heading",
                    "formats": {},
                    "type": "h2",
                    "text": "Choose exactly what you’d like to receive"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "We want to make sure you only get the content that matters most to you. Here you can update your subscription preferences for <strong>{{LIST_NAME}}</strong> and tailor the emails you receive from us."
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "Please review the options below and select the topics, frequency, or updates that best fit your interests. Once you’re done, simply click the button to save your preferences."
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{FIELDS}}"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{UPDATE_PROFILE_BUTTON}}"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "If you’d rather stop receiving all emails from us, you can easily unsubscribe at any time by clicking the link below."
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "LinkElement",
                    "template": "Link",
                    "formats": {},
                    "text": "Unsubscribe",
                    "url": "{{UNSUBSCRIBE_URL}}",
                    "target": "",
                    "rel": "",
                    "title": "",
                    "download": "",
                    "ariaLabel": ""
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 60
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {
                        "font_size": 13,
                        "text_align": "center"
                    },
                    "text": "Copyright (C). {{LIST_NAME}} | This is an automated message, please do not reply."
                }
            ]
        }
    ],
    "block_gap": 0,
    "container_width": "medium",
    "block_padding_bottom": 20,
    "block_padding_top": 20,
    "block_padding_right": 20,
    "block_padding_left": 20,
    "default_block_background_color": "#FFFFFF"
}