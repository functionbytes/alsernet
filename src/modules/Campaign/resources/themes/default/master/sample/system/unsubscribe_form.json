{
    "theme": "default",
    "name": "PageElement",
    "template": "Page",
    "formats": {
        "background_color": "#F4F4F4",
        "padding_top": 40,
        "padding_right": 60,
        "padding_bottom": 40,
        "padding_left": 60
    },
    "page_title": "You Have Chosen to Unsubscribe",
    "blocks": [
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 40
            },
            "elements": [
                {
                    "name": "HeadingElement",
                    "template": "Heading",
                    "formats": {},
                    "type": "h1",
                    "text": "You Have Chosen to Unsubscribe"
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{LIST_NAME}}"
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{CURRENT_DATE}}"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 0,
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "DividerElement",
                    "template": "Divider",
                    "formats": {
                        "background_color": "#D0D0D0",
                        "height": 2,
                        "divider_style": "solid",
                        "padding_top": 10,
                        "padding_bottom": 10
                    }
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "HeadingElement",
                    "template": "Heading",
                    "formats": {},
                    "type": "h2",
                    "text": "We’re truly sorry to see you go 💔"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "You are about to opt out of the mailing list <strong>{{LIST_NAME}}</strong>. Once confirmed, you will no longer receive our updates, news, or special offers. If this was a mistake, you can simply ignore this message and your subscription will remain active."
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{UNSUBSCRIBE_BUTTON}}"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "If this was a mistake, you can safely ignore this message and your subscription will remain active."
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 60
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {
                        "font_size": 13,
                        "text_align": "center"
                    },
                    "text": "Copyright (C). {{LIST_NAME}} | This is an automated message, please do not reply."
                }
            ]
        }
    ],
    "block_gap": 0,
    "container_width": "medium",
    "block_padding_bottom": 20,
    "block_padding_top": 20,
    "block_padding_right": 20,
    "block_padding_left": 20,
    "default_block_background_color": "#FFFFFF"
}