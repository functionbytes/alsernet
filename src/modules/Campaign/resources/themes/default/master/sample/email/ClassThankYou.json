{
    "theme": "default",
    "name": "PageElement",
    "template": "Page",
    "formats": {
        "background_color": "#E6E6E6",
        "padding_top": 0,
        "padding_right": 0,
        "padding_bottom": 0,
        "padding_left": 0
    },
    "page_title": null,
    "blocks": [
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "padding_top": 60,
                "padding_bottom": 60
            },
            "elements": [
                {
                    "name": "GridElement",
                    "template": "Grid",
                    "formats": {
                        "align_items": "stretch"
                    },
                    "cells": [
                        {
                            "name": "CellElement",
                            "template": "Cell",
                            "formats": {
                                "width": "auto"
                            },
                            "blocks": [
                                {
                                    "name": "BlockElement",
                                    "template": "Block",
                                    "formats": {},
                                    "elements": [
                                        {
                                            "name": "HeadingElement",
                                            "template": "Heading",
                                            "formats": {
                                                "font_family": "Arial Black",
                                                "font_size": 72,
                                                "text_color": "#1A1A1A",
                                                "text_align": "left",
                                                "line_height": 1.1,
                                                "padding_top": 85
                                            },
                                            "type": "h1",
                                            "text": "Thank<br>You"
                                        },
                                        {
                                            "name": "PElement",
                                            "template": "P",
                                            "formats": {
                                                "font_size": 22,
                                                "text_color": "#1A1A1A",
                                                "text_align": "left",
                                                "line_height": 1.4
                                            },
                                            "text": "Congrats on completing<br>the branding course!"
                                        }
                                    ]
                                }
                            ],
                            "vertical_align": "top"
                        },
                        {
                            "name": "CellElement",
                            "template": "Cell",
                            "formats": {
                                "width": "auto"
                            },
                            "blocks": [
                                {
                                    "name": "BlockElement",
                                    "template": "Block",
                                    "formats": {},
                                    "elements": [
                                        {
                                            "name": "ImageElement",
                                            "template": "Image",
                                            "formats": {
                                                "padding_bottom": 200,
                                                "width": 130,
                                                "align": "right",
                                                "border_radius": 0
                                            },
                                            "src": "master/assets/image/ClassThankYou/logo.png",
                                            "alt": "",
                                            "url": "",
                                            "target": "",
                                            "rel": "",
                                            "title": "",
                                            "download": "",
                                            "effect": {
                                                "grayscale": null,
                                                "sepia": null,
                                                "invert": null,
                                                "blur": null,
                                                "brightness": null,
                                                "contrast": null,
                                                "saturate": null,
                                                "hueRotate": null,
                                                "opacity": null
                                            },
                                            "crop": {
                                                "enabled": false,
                                                "ratioX": 3,
                                                "ratioY": 2,
                                                "zoom": 1,
                                                "posX": 50,
                                                "posY": 50
                                            }
                                        }
                                    ]
                                },
                                {
                                    "name": "BlockElement",
                                    "template": "Block",
                                    "formats": {},
                                    "elements": [
                                        {
                                            "name": "PElement",
                                            "template": "P",
                                            "formats": {
                                                "font_size": 15,
                                                "text_color": "#1A1A1A",
                                                "text_align": "left",
                                                "line_height": 1.45
                                            },
                                            "text": "We’re thrilled to have been a part of your branding journey. We hope that the course has provided you with valuable insights into the fundamentals of brand. Share your feedback on the course below."
                                        }
                                    ]
                                }
                            ],
                            "vertical_align": "top"
                        }
                    ],
                    "cell_gap": 40
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#252525",
                "padding_top": 60,
                "padding_bottom": 60
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {
                        "font_size": 20,
                        "text_color": "#F8F5EE",
                        "padding_bottom": 20
                    },
                    "text": "We want to hear from you"
                },
                {
                    "name": "HeadingElement",
                    "template": "Heading",
                    "formats": {
                        "font_size": 42,
                        "text_color": "#FFFFFF",
                        "line_height": 1.2,
                        "padding_bottom": 30
                    },
                    "type": "h2",
                    "text": "We would love to hear<br>about your experience."
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {
                        "text_align": "right",
                        "padding_top": 0,
                        "padding_bottom": 0
                    },
                    "text": "<a href=\"#\" style=\"display:inline-block;text-decoration:none;color:#FFFFFF;border:2px solid #FFFFFF;padding:14px 30px;font-size:18px;font-family:Arial;\">SHARE FEEDBACK</a>"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "padding_top": 40,
                "padding_bottom": 40
            },
            "elements": [
                {
                    "name": "SocialIconsElement",
                    "template": "SocialIcons",
                    "formats": {
                        "background_position": "center",
                        "background_size": "100%",
                        "background_repeat": "no-repeat"
                    },
                    "items": [
                        {
                            "link": "#",
                            "image_url": "master/assets/image/ClassThankYou/facebook.png",
                            "label": "Facebook"
                        },
                        {
                            "link": "#",
                            "image_url": "master/assets/image/ClassThankYou/instagram.png",
                            "label": "Instagram"
                        },
                        {
                            "link": "#",
                            "image_url": "master/assets/image/ClassThankYou/twitter.png",
                            "label": "X"
                        }
                    ],
                    "size": 35,
                    "gap": 25,
                    "align": "left"
                },
                {
                    "name": "LinkElement",
                    "template": "Link",
                    "formats": {
                        "font_size": 14,
                        "text_color": "#4A3034",
                        "text_align": "left"
                    },
                    "text": "View in browser",
                    "url": "{{WEB_VIEW_URL}}",
                    "target": "",
                    "rel": "",
                    "title": "",
                    "download": "",
                    "ariaLabel": ""
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {
                        "font_size": 12,
                        "text_align": "left",
                        "padding_top": 20
                    },
                    "text": "Copyright (C) {{CURRENT_YEAR}}. All rights reserved."
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {
                        "font_size": 12,
                        "text_align": "left",
                        "padding_top": 20
                    },
                    "text": "If you no longer want to receive these emails, you can <a href=\"{{UNSUBSCRIBE_URL}}\">unsubscribe</a>."
                }
            ]
        }
    ],
    "block_gap": 0,
    "container_width": "medium",
    "block_padding_bottom": 40,
    "block_padding_top": 40,
    "block_padding_right": 40,
    "block_padding_left": 40,
    "default_block_background_color": "#F8F5EE"
}