{
    "theme": "default",
    "name": "PageElement",
    "template": "Page",
    "formats": {
        "background_color": "#F4F4F4",
        "padding_top": 40,
        "padding_right": 60,
        "padding_bottom": 40,
        "padding_left": 60
    },
    "page_title": "Almost finished...!",
    "blocks": [
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 40
            },
            "elements": [
                {
                    "name": "HeadingElement",
                    "template": "Heading",
                    "formats": {},
                    "type": "h1",
                    "text": "Just one more step to join us!"
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{LIST_NAME}}"
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{CURRENT_DATE}}"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 0,
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "DividerElement",
                    "template": "Divider",
                    "formats": {
                        "background_color": "#D0D0D0",
                        "height": 2,
                        "divider_style": "solid",
                        "padding_top": 10,
                        "padding_bottom": 10
                    }
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "HeadingElement",
                    "template": "Heading",
                    "formats": {},
                    "type": "h2",
                    "text": "Email Confirmation"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "Please <strong>confirm your subscription</strong> by clicking the link below:"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "LinkElement",
                    "template": "Link",
                    "formats": {},
                    "text": "{{SUBSCRIBE_CONFIRM_URL}}",
                    "url": "{{SUBSCRIBE_CONFIRM_URL}}",
                    "target": "",
                    "rel": "",
                    "title": "",
                    "download": "",
                    "ariaLabel": ""
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "This confirmation helps us <strong>keep your account secure</strong> and ensures you’ll receive important updates without interruption."
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 60
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {
                        "font_size": 13,
                        "text_align": "center"
                    },
                    "text": "Copyright (C). {{LIST_NAME}} | This is an automated message, please do not reply."
                }
            ]
        }
    ],
    "block_gap": 0,
    "container_width": "medium",
    "block_padding_bottom": 20,
    "block_padding_top": 20,
    "block_padding_right": 20,
    "block_padding_left": 20,
    "default_block_background_color": "#FFFFFF"
}