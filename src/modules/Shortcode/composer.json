{
    "name": "inoqualab/shortcode",
    "description": "Sistema de shortcodes estilo WordPress para Laravel, con parser stack-based, cache persistente, eventos, whitelist por contexto, HTMLPurifier pipeline, CSP nonce y 9 comandos artisan.",
    "keywords": [
        "laravel",
        "shortcode",
        "bbcode",
        "content",
        "parser",
        "compiler",
        "wordpress-like",
        "cms"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Inoqualab",
            "email": "info@inoqualab.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.0"
    },
    "suggest": {
        "ezyang/htmlpurifier": "Activar el pipeline de sanitización para shortcodes con meta['purify']=true",
        "spatie/laravel-permission": "Requerido por [if role=...] y la protección de los endpoints API",
        "laravel/sanctum": "Autenticación para los endpoints de /api/shortcodes/*",
        "laravel/telescope": "Observabilidad — habilita ShortcodeWatcher en config/telescope.php",
        "modules/forms": "Habilita el shortcode [form id=...|slug=...]",
        "modules/page": "Habilita el shortcode [page slug=...]",
        "modules/blog": "Habilita [latest-posts] y [post id=...]",
        "modules/media": "Habilita el shortcode [media id=...]",
        "modules/template": "Habilita [menu location=...]"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Shortcode\\Providers\\ShortcodeServiceProvider"
            ],
            "aliases": {
                "Shortcode": "Modules\\Shortcode\\Facades\\Shortcode"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Shortcode\\": "app/",
            "Modules\\Shortcode\\Database\\Factories\\": "database/factories/",
            "Modules\\Shortcode\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "helpers/shortcode.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Shortcode\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
