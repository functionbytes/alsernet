{
    "name": "inoqua/Cookie-module",
    "description": "GDPR-compliant cookie consent management module for Laravel",
    "type": "laravel-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Inoqua Lab",
            "email": "dev@inoqualab.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Cookie\\": "app/",
            "Modules\\Cookie\\Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Cookie\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Cookie\\Providers\\CookieServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
