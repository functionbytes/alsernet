{
    "name": "modules/mailrelay",
    "description": "Módulo de email marketing y automatización con integración Mailrelay",
    "type": "laravel-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Alsernet Team",
            "email": "dev@alsernet.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8",
        "maatwebsite/excel": "^3.1",
        "barryvdh/laravel-dompdf": "^3.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "soundasleep/html2text": "^2.1",
        "myclabs/php-enum": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "barryvdh/laravel-ide-helper": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Mailrelay\\": "app/",
            "Modules\\Mailrelay\\Providers\\": "providers/",
            "Modules\\Mailrelay\\Database\\Factories\\": "database/factories/",
            "Modules\\Mailrelay\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Mailrelay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Mailrelay\\Providers\\MailrelayServiceProvider"
            ]
        }
    }
}
