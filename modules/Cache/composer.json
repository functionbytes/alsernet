{
    "name": "modules/cache-settings",
    "description": "Cache settings module",
    "authors": [],
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Cache\\Providers\\CacheServiceProvider"
            ]
        }
    },
    "autoload": {
