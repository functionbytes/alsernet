{
    "theme": "default",
    "name": "PageElement",
    "template": "Page",
    "formats": {
        "background_color": "#F4F4F4",
        "padding_top": 40,
        "padding_right": 60,
        "padding_bottom": 40,
        "padding_left": 60
    },
    "page_title": "New Subscription Notification",
    "blocks": [
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 40
            },
            "elements": [
                {
                    "name": "HeadingElement",
                    "template": "Heading",
                    "formats": {},
                    "type": "h1",
                    "text": "New Subscription Notification"
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{LIST_NAME}}"
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{CURRENT_DATE}}"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 0,
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "DividerElement",
                    "template": "Divider",
                    "formats": {
                        "background_color": "#D0D0D0",
                        "height": 2,
                        "divider_style": "solid",
                        "padding_top": 10,
                        "padding_bottom": 10
                    }
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "HeadingElement",
                    "template": "Heading",
                    "formats": {},
                    "type": "h2",
                    "text": "A new subscriber has joined your list"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "This is an automated notification to inform you that a new subscriber has been added to your list <strong>{{LIST_NAME}}</strong>:"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "• <span class=\"fw-bold\">Name:</span> {{SUBSCRIBER_FIRST_NAME}} {{SUBSCRIBER_LAST_NAME}}<br>• <span class=\"fw-bold\">Email:</span> {{SUBSCRIBER_EMAIL}}"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "No further action is required. This message is provided for your records only."
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "If this subscription was unexpected, you may wish to review your list settings or contact support for further details. Otherwise, you can safely archive this message."
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "padding_top": 60
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {
                        "font_size": 13,
                        "text_align": "center"
                    },
                    "text": "Copyright (C). {{LIST_NAME}} | This is an automated message, please do not reply."
                }
            ]
        }
    ],
    "block_gap": 0,
    "container_width": "medium",
    "block_padding_bottom": 20,
    "block_padding_top": 20,
    "block_padding_right": 20,
    "block_padding_left": 20,
    "default_block_background_color": "#FFFFFF"
}