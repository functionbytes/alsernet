{
    "theme": "default",
    "name": "PageElement",
    "template": "Page",
    "formats": {
        "background_color": "#F4F4F4",
        "padding_top": 40,
        "padding_right": 60,
        "padding_bottom": 40,
        "padding_left": 60
    },
    "page_title": "Verify Your Email Address",
    "blocks": [
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF"
            },
            "elements": [
                {
                    "name": "HeadingElement",
                    "template": "Heading",
                    "formats": {},
                    "type": "h1",
                    "text": "Verify Your Email Address"
                },
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "{{CURRENT_DATE}}"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "border_radius": 0,
                "padding_top": 0,
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "DividerElement",
                    "template": "Divider",
                    "formats": {
                        "background_color": "#D0D0D0",
                        "height": 2,
                        "divider_style": "solid",
                        "padding_top": 10,
                        "padding_bottom": 10
                    }
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "border_radius": 0,
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "Hi {{USER_NAME}}, we need to confirm your email"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "border_radius": 0,
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "We received a request to register <strong>{{USER_EMAIL}}</strong> as a sender in our system. To complete this process, please confirm that you own this email address by clicking the button below:"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF"
            },
            "elements": [
                {
                    "name": "LinkElement",
                    "template": "Link",
                    "formats": {},
                    "text": "Verify My Email",
                    "url": "{{VERIFICATION_LINK}}",
                    "target": "",
                    "rel": "",
                    "title": "",
                    "download": "",
                    "ariaLabel": ""
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF",
                "border_radius": 0,
                "padding_bottom": 0
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {},
                    "text": "If the button above does not work, copy and paste this link into your browser:"
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF"
            },
            "elements": [
                {
                    "name": "LinkElement",
                    "template": "Link",
                    "formats": {},
                    "text": "{{VERIFICATION_LINK}}",
                    "url": "{{VERIFICATION_LINK}}",
                    "target": "",
                    "rel": "",
                    "title": "",
                    "download": "",
                    "ariaLabel": ""
                }
            ]
        },
        {
            "name": "BlockElement",
            "template": "Block",
            "formats": {
                "background_color": "#FFFFFF"
            },
            "elements": [
                {
                    "name": "PElement",
                    "template": "P",
                    "formats": {
                        "font_size": 13,
                        "text_align": "center"
                    },
                    "text": "Copyright (C). All rights reserved."
                }
            ]
        }
    ],
    "block_gap": 0,
    "container_width": "medium",
    "block_padding_bottom": 20,
    "block_padding_top": 20,
    "block_padding_right": 20,
    "block_padding_left": 20,
    "default_block_background_color": "#FFFFFF"
}