{
    "name": "modules/reviews",
    "description": "Google Business Profile reviews management module",
    "authors": [],
    "require": {
        "google/apiclient": "^2.15"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Reviews\\Providers\\ReviewsServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Reviews\\": "app/",
            "Modules\\Reviews\\Database\\Factories\\": "database/factories/",
            "Modules\\Reviews\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Reviews\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev"
}
