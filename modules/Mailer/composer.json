{
    "name": "modules/mailer",
    "description": "Mailer Management Module - Email templates, configuration, SMTP providers, scheduling",
    "keywords": ["mailer", "email", "smtp", "templates", "campaigns"],
    "authors": [
        {
            "name": "Alsernet Development",
            "email": "dev@alsernet.com"
        }
    ],
    "require": {
        "phpmailer/phpmailer": "^6.9",
        "twig/twig": "^3.19",
        "ashallendesign/email-utilities": "^1.0",
        "spatie/laravel-medialibrary": "^10.0|^11.0",
        "barryvdh/laravel-translation-manager": "^0.6.8"
    },
    "extra": {
        "laravel": {
            "providers": [],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Mailer\\": "app/",
            "Modules\\Mailer\\Database\\Factories\\": "database/factories/",
