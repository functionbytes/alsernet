{
    "name": "inoqua/Seo",
    "description": "SEO Helper module for Laravel",
    "type": "laravel-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Inoqua Lab",
            "email": "info@inoqualab.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Seo\\": "app/",
            "Modules\\Seo\\Database\\Factories\\": "database/factories/",
            "Modules\\Seo\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Seo\\Providers\\SeoServiceProvider"
            ]
        }
    }
}
