{
    "name": "modules/horizon",
    "description": "Horizon Module - Queue monitoring, job management, Redis supervision",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "horizon",
        "queue",
        "monitoring",
        "jobs",
        "redis"
    ],
    "authors": [
        {
            "name": "Alsernet Development",
            "email": "dev@alsernet.com"
        }
    ],
    "require": {
        "laravel/horizon": "^5.41"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Horizon\\": "app/",
            "Modules\\Horizon\\Database\\Factories\\": "database/factories/",
            "Modules\\Horizon\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Horizon\\Tests\\": "tests/"
        }
    }
}
