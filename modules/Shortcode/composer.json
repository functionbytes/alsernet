{
    "name": "inoqualab/shortcode",
    "description": "A powerful and flexible shortcode system for Laravel applications",
    "keywords": [
        "laravel",
        "shortcode",
        "wordpress-like",
        "content",
        "parser",
        "compiler"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Inoqualab",
            "email": "info@inoqualab.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Shortcode\\Providers\\ShortcodeServiceProvider"
            ],
            "aliases": {
                "Shortcode": "Modules\\Shortcode\\Facades\\Shortcode"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Shortcode\\": "app/",
            "Modules\\Shortcode\\Database\\Factories\\": "database/factories/",
            "Modules\\Shortcode\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "helpers/shortcode.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Shortcode\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
