# ============================================================================
# MAILING MODULE CONFIGURATION
# ============================================================================
# This file contains all environment variables for the Mailing module
# Copy this file to your main .env and adjust values as needed
# ============================================================================

# ----------------------------------------------------------------------------
# Mailrelay API Configuration
# ----------------------------------------------------------------------------
MAILING_URL=https://your-account.mailrelay.com/api/v1
MAILING_API_KEY=your_api_key_here
MAILING_TIMEOUT=30
MAILING_CONNECT_TIMEOUT=10

# Retry Configuration
MAILING_RETRY_MAX_ATTEMPTS=3
MAILING_RETRY_DELAY=100
MAILING_RETRY_MULTIPLIER=2

# ----------------------------------------------------------------------------
# Sync Settings
# ----------------------------------------------------------------------------
MAILING_AUTO_SYNC=true
MAILING_SYNC_BATCH_INTERVAL=60
MAILING_SYNC_BATCH_SIZE=100
MAILING_SYNC_USE_QUEUE=true
MAILING_SYNC_QUEUE_NAME=mailing
MAILING_SYNC_RETRY_FAILED=true
MAILING_SYNC_MAX_RETRIES=3
MAILING_SYNC_TRACK_HISTORY=true
MAILING_SYNC_METADATA=true
MAILING_SYNC_GROUPS=true

# ----------------------------------------------------------------------------
# Webhook Settings
# ----------------------------------------------------------------------------
MAILING_WEBHOOK_ENABLED=true
MAILING_WEBHOOK_PATH=/api/webhooks/mailrelay
MAILING_WEBHOOK_SECRET=your_webhook_secret_here
MAILING_WEBHOOK_VERIFY_SIGNATURE=true
MAILING_WEBHOOK_LOG_EVENTS=true
MAILING_WEBHOOK_USE_QUEUE=true
MAILING_WEBHOOK_QUEUE_NAME=webhooks
MAILING_WEBHOOK_TIMEOUT=30
MAILING_WEBHOOK_MAX_PAYLOAD_SIZE=1048576
# MAILING_WEBHOOK_IP_WHITELIST=192.168.1.1,192.168.1.2

# ----------------------------------------------------------------------------
# Cache Settings
# ----------------------------------------------------------------------------
MAILING_CACHE_ENABLED=true
MAILING_CACHE_DRIVER=redis
MAILING_CACHE_TTL_SUBSCRIBERS=3600
MAILING_CACHE_TTL_GROUPS=3600
MAILING_CACHE_TTL_CAMPAIGNS=1800
MAILING_CACHE_TTL_ANALYTICS=300
MAILING_CACHE_PREFIX=mailing
MAILING_CACHE_AUTO_INVALIDATE=true

# ----------------------------------------------------------------------------
# Default Group Settings
# ----------------------------------------------------------------------------
# MAILING_DEFAULT_GROUP_ID=1
MAILING_DEFAULT_GROUP_AUTO_ASSIGN=true

# ----------------------------------------------------------------------------
# Campaign Settings
# ----------------------------------------------------------------------------
# MAILING_CAMPAIGN_DEFAULT_SENDER_ID=1
MAILING_CAMPAIGN_TRACK_ANALYTICS=true
MAILING_CAMPAIGN_ANALYTICS_SYNC_INTERVAL=30
MAILING_CAMPAIGN_TEST_MODE=false
# MAILING_CAMPAIGN_TEST_EMAILS=test1@example.com,test2@example.com

# ----------------------------------------------------------------------------
# Logging Settings
# ----------------------------------------------------------------------------
MAILING_LOGGING_ENABLED=false
MAILING_LOGGING_CHANNEL=stack
MAILING_LOGGING_LEVEL=info
MAILING_LOG_REQUESTS=true
MAILING_LOG_RESPONSES=true
MAILING_LOG_REQUEST_BODY=false
MAILING_LOG_RESPONSE_BODY=false

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
MAILING_RATE_LIMIT_ENABLED=true
MAILING_RATE_LIMIT_MAX_REQUESTS=60
MAILING_RATE_LIMIT_DECAY_MINUTES=1
MAILING_RATE_LIMIT_DELAY=50

# ----------------------------------------------------------------------------
# Validation Settings
# ----------------------------------------------------------------------------
MAILING_VALIDATION_ENABLED=true
MAILING_VALIDATION_MIN_SCORE=70
# MAILING_VALIDATION_SKIP_DOMAINS=example.com,test.com
MAILING_VALIDATION_BLOCK_DISPOSABLE=true
MAILING_VALIDATION_BLOCK_ROLE_BASED=false

# ----------------------------------------------------------------------------
# Error Handling
# ----------------------------------------------------------------------------
MAILING_THROW_EXCEPTIONS=true
MAILING_NOTIFY_ON_ERROR=false
# MAILING_ERROR_NOTIFICATION_RECIPIENTS=admin@example.com

# ----------------------------------------------------------------------------
# Testing & Development
# ----------------------------------------------------------------------------
MAILING_SANDBOX_MODE=false
MAILING_MOCK_API=false
MAILING_DEBUG=false

# ============================================================================
# ACELLE MAIL EXTENDED CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# Email Tracking Configuration
# ----------------------------------------------------------------------------
MAILING_TRACK_OPENS=true
MAILING_TRACK_CLICKS=true
MAILING_TRACK_UNSUBSCRIBES=true
# MAILING_TRACKING_DOMAIN=track.yourdomain.com
MAILING_TRACKING_HTTPS=true
MAILING_CLICK_TRACKING_QUEUE=tracking
MAILING_OPEN_TRACKING_QUEUE=tracking

# ----------------------------------------------------------------------------
# Subscriber Import Settings
# ----------------------------------------------------------------------------
MAILING_IMPORT_MAX_FILE_SIZE=50
MAILING_IMPORT_BATCH_SIZE=1000
MAILING_IMPORT_QUEUE=imports
MAILING_IMPORT_CSV_DELIMITER=,
MAILING_IMPORT_CSV_ENCLOSURE='"'
MAILING_IMPORT_SKIP_DUPLICATES=true
MAILING_IMPORT_VALIDATE_EMAILS=true
MAILING_IMPORT_MAX_EXECUTION_TIME=7200

# ----------------------------------------------------------------------------
# Sending Server Settings
# ----------------------------------------------------------------------------
MAILING_SENDING_SERVER_DEFAULT_TYPE=smtp
MAILING_SENDING_SERVER_ROTATION=round-robin
MAILING_SENDING_SERVER_HEALTH_CHECK=true
MAILING_SENDING_SERVER_HEALTH_CHECK_INTERVAL=15
MAILING_SENDING_SERVER_AUTO_DISABLE_THRESHOLD=5
MAILING_SENDING_SERVER_QUOTA_HOUR=10000
MAILING_SENDING_SERVER_QUOTA_DAY=100000
MAILING_SENDING_SERVER_CONNECTION_TIMEOUT=30

# ----------------------------------------------------------------------------
# Bounce Handler Settings
# ----------------------------------------------------------------------------
MAILING_BOUNCE_HANDLER_ENABLED=false
MAILING_BOUNCE_HANDLER_TYPE=imap
# MAILING_BOUNCE_HANDLER_HOST=imap.example.com
# MAILING_BOUNCE_HANDLER_PORT=993
# MAILING_BOUNCE_HANDLER_USERNAME=bounces@example.com
# MAILING_BOUNCE_HANDLER_PASSWORD=password
MAILING_BOUNCE_HANDLER_ENCRYPTION=ssl
MAILING_BOUNCE_HANDLER_QUEUE=bounces
MAILING_BOUNCE_HANDLER_INTERVAL=5
MAILING_BOUNCE_HANDLER_MAX_PROCESS=500
MAILING_BOUNCE_HARD_ACTION=unsubscribe
MAILING_BOUNCE_SOFT_THRESHOLD=5
MAILING_BOUNCE_DELETE_AFTER_PROCESSING=true

# ----------------------------------------------------------------------------
# Feedback Loop Handler Settings
# ----------------------------------------------------------------------------
MAILING_FEEDBACK_LOOP_ENABLED=false
MAILING_FEEDBACK_LOOP_TYPE=imap
# MAILING_FEEDBACK_LOOP_HOST=imap.example.com
# MAILING_FEEDBACK_LOOP_PORT=993
# MAILING_FEEDBACK_LOOP_USERNAME=feedback@example.com
# MAILING_FEEDBACK_LOOP_PASSWORD=password
MAILING_FEEDBACK_LOOP_ENCRYPTION=ssl
MAILING_FEEDBACK_LOOP_QUEUE=feedback
MAILING_FEEDBACK_LOOP_INTERVAL=10
MAILING_FEEDBACK_LOOP_ACTION=unsubscribe
MAILING_FEEDBACK_LOOP_DELETE_AFTER_PROCESSING=true

# ----------------------------------------------------------------------------
# Template Settings
# ----------------------------------------------------------------------------
MAILING_TEMPLATE_CACHE_ENABLED=true
MAILING_TEMPLATE_CACHE_TTL=60
MAILING_TEMPLATE_DEFAULT_LANGUAGE=en
MAILING_TEMPLATE_ALLOW_CUSTOM_CSS=true
MAILING_TEMPLATE_ALLOW_CUSTOM_JS=false
MAILING_TEMPLATE_MAX_SIZE=500
MAILING_TEMPLATE_STORAGE_PATH=mailing/templates
MAILING_TEMPLATE_VERSIONING=true

# ----------------------------------------------------------------------------
# Automation Settings
# ----------------------------------------------------------------------------
MAILING_AUTOMATION_ENABLED=true
MAILING_AUTOMATION_QUEUE=automation
MAILING_AUTOMATION_INTERVAL=1
MAILING_AUTOMATION_MAX_PROCESS=100
MAILING_AUTOMATION_TRIGGERS_ENABLED=true
MAILING_AUTOMATION_MAX_DEPTH=5

# ----------------------------------------------------------------------------
# Segmentation Settings
# ----------------------------------------------------------------------------
MAILING_SEGMENTATION_ENABLED=true
MAILING_SEGMENTATION_CACHE_TTL=30
MAILING_SEGMENTATION_REALTIME_THRESHOLD=10000
MAILING_SEGMENTATION_QUEUE=segments
MAILING_SEGMENTATION_MAX_CONDITIONS=20

# ----------------------------------------------------------------------------
# List Settings
# ----------------------------------------------------------------------------
MAILING_LIST_DOUBLE_OPTIN_DEFAULT=true
MAILING_LIST_SEND_WELCOME_EMAIL_DEFAULT=false
MAILING_LIST_SEND_UNSUBSCRIBE_NOTIFICATION=true
MAILING_LIST_MAX_PER_USER=100
MAILING_LIST_VERIFICATION_ENABLED=true
MAILING_LIST_CLEANUP_ENABLED=false
MAILING_LIST_CLEANUP_THRESHOLD_DAYS=365

# ----------------------------------------------------------------------------
# Email Verification Settings
# ----------------------------------------------------------------------------
MAILING_VERIFICATION_ADVANCED_ENABLED=false
MAILING_VERIFICATION_SERVICE=internal
# MAILING_VERIFICATION_API_KEY=your_verification_api_key
# MAILING_VERIFICATION_API_SECRET=your_verification_api_secret
MAILING_VERIFICATION_QUEUE=verification
MAILING_VERIFICATION_AUTO_IMPORT=false
MAILING_VERIFICATION_REMOVE_INVALID=true
MAILING_VERIFICATION_CACHE_TTL_DAYS=30

# ----------------------------------------------------------------------------
# Deliverability Settings
# ----------------------------------------------------------------------------
MAILING_DKIM_ENABLED=false
MAILING_DKIM_SELECTOR=default
# MAILING_DKIM_PRIVATE_KEY_PATH=/path/to/private.key
# MAILING_DKIM_DOMAIN=yourdomain.com
MAILING_SPF_ENABLED=true
MAILING_DMARC_ENABLED=false
MAILING_HEADER_LIST_UNSUBSCRIBE=true
MAILING_HEADER_PRECEDENCE=bulk

# ----------------------------------------------------------------------------
# Reporting Settings
# ----------------------------------------------------------------------------
MAILING_REPORTING_ENABLED=true
MAILING_REPORTING_QUEUE=reports
MAILING_REPORTING_CACHE_TTL=60
MAILING_REPORTING_REALTIME_STATS=true
MAILING_REPORTING_AGGREGATION_INTERVAL=5
MAILING_REPORTING_MAX_HISTORY_DAYS=365

# ----------------------------------------------------------------------------
# Storage Settings
# ----------------------------------------------------------------------------
MAILING_STORAGE_DISK=local
MAILING_STORAGE_ATTACHMENTS_PATH=mailing/attachments
MAILING_STORAGE_MAX_ATTACHMENT_SIZE=10
MAILING_STORAGE_EXPORT_RETENTION_DAYS=7
MAILING_STORAGE_TEMP_CLEANUP_INTERVAL=24

# ----------------------------------------------------------------------------
# Security Settings
# ----------------------------------------------------------------------------
MAILING_SECURITY_CAPTCHA_ENABLED=false
MAILING_SECURITY_CAPTCHA_TYPE=recaptcha
# MAILING_SECURITY_RECAPTCHA_SITE_KEY=your_site_key
# MAILING_SECURITY_RECAPTCHA_SECRET_KEY=your_secret_key
MAILING_SECURITY_HONEYPOT_ENABLED=true
MAILING_SECURITY_IP_RATE_LIMITING=true
MAILING_SECURITY_MAX_SUBSCRIPTIONS_PER_IP=10
MAILING_SECURITY_BLACKLIST_CHECK=false

# ----------------------------------------------------------------------------
# Localization Settings
# ----------------------------------------------------------------------------
MAILING_LOCALIZATION_DEFAULT_LANGUAGE=es
MAILING_LOCALIZATION_TIMEZONE_ENABLED=true
MAILING_LOCALIZATION_DEFAULT_TIMEZONE=Europe/Madrid
MAILING_LOCALIZATION_RTL_ENABLED=false

# ----------------------------------------------------------------------------
# Performance Settings
# ----------------------------------------------------------------------------
MAILING_PERFORMANCE_QUERY_CACHE=true
MAILING_PERFORMANCE_QUERY_CACHE_TTL=10
MAILING_PERFORMANCE_LAZY_LOADING=true
MAILING_PERFORMANCE_CHUNK_SIZE=1000
MAILING_PERFORMANCE_CONNECTION_POOLING=true
MAILING_PERFORMANCE_MAX_CONNECTIONS=100

# ============================================================================
# EXTERNAL EMAIL SERVICE PROVIDERS
# ============================================================================
# Configuration for third-party email sending services
# These are used by the sending server functionality

# ----------------------------------------------------------------------------
# AWS SES (Simple Email Service)
# ----------------------------------------------------------------------------
# Amazon Web Services SES credentials for email sending
# Requires AWS account with SES enabled
# AWS_SES_KEY=AKIAIOSFODNN7EXAMPLE
# AWS_SES_SECRET=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_SES_REGION=us-east-1

# ----------------------------------------------------------------------------
# Mailgun
# ----------------------------------------------------------------------------
# Mailgun API credentials for transactional email
# Register at https://www.mailgun.com
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_SECRET=key-1234567890abcdef1234567890abcdef
# MAILGUN_ENDPOINT=api.mailgun.net

# ----------------------------------------------------------------------------
# SendGrid
# ----------------------------------------------------------------------------
# SendGrid API key for email delivery
# Register at https://sendgrid.com
# SENDGRID_API_KEY=SG.1234567890abcdefghijklmnopqrstuvwxyz

# ----------------------------------------------------------------------------
# SparkPost
# ----------------------------------------------------------------------------
# SparkPost API key for email sending
# Register at https://www.sparkpost.com
# SPARKPOST_API_KEY=1234567890abcdef1234567890abcdef12345678

# ----------------------------------------------------------------------------
# Elastic Email
# ----------------------------------------------------------------------------
# Elastic Email API key
# Register at https://elasticemail.com
# ELASTICEMAIL_API_KEY=1234567890abcdef1234567890abcdef

# ----------------------------------------------------------------------------
# Postmark
# ----------------------------------------------------------------------------
# Postmark server token for transactional email
# Register at https://postmarkapp.com
# POSTMARK_TOKEN=1234567890ab-cdef-1234-5678-90abcdef1234

# ----------------------------------------------------------------------------
# Mandrill (MailChimp Transactional)
# ----------------------------------------------------------------------------
# Mandrill API key (MailChimp transactional email service)
# Note: Mandrill was merged into MailChimp Transactional Email
# MANDRILL_API_KEY=1234567890abcdef1234567890abcdef-us1

# ----------------------------------------------------------------------------
# Amazon SES SMTP Credentials
# ----------------------------------------------------------------------------
# Alternative SMTP-based authentication for AWS SES
# These are different from AWS access keys
# AWS_SES_SMTP_USERNAME=smtp-username
# AWS_SES_SMTP_PASSWORD=smtp-password
# AWS_SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# AWS_SES_SMTP_PORT=587

