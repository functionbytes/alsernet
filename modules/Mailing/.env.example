# ============================================================================
# ADDITIONAL SMTP PROVIDERS
# ============================================================================
# Generic SMTP server configuration examples
# Can be used for any SMTP-compatible service

# ----------------------------------------------------------------------------
# Generic SMTP Server 1
# ----------------------------------------------------------------------------
# SMTP_SERVER_1_HOST=smtp.example.com
# SMTP_SERVER_1_PORT=587
# SMTP_SERVER_1_USERNAME=user@example.com
# SMTP_SERVER_1_PASSWORD=password
# SMTP_SERVER_1_ENCRYPTION=tls
# SMTP_SERVER_1_FROM_EMAIL=noreply@example.com
# SMTP_SERVER_1_FROM_NAME=Example App

# ----------------------------------------------------------------------------
# Generic SMTP Server 2
# ----------------------------------------------------------------------------
# SMTP_SERVER_2_HOST=smtp2.example.com
# SMTP_SERVER_2_PORT=465
# SMTP_SERVER_2_USERNAME=user@example.com
# SMTP_SERVER_2_PASSWORD=password
# SMTP_SERVER_2_ENCRYPTION=ssl
# SMTP_SERVER_2_FROM_EMAIL=info@example.com
# SMTP_SERVER_2_FROM_NAME=Example Info

# ============================================================================
# LEGACY ACELLE COMPATIBILITY
# ============================================================================
# Variables for backward compatibility with Acelle Mail installations

# Application modes from Acelle
# APP_DEMO=false
# APP_SAAS=true
# APP_BRAND=false
# APP_STORE=false
# APP_CARTPAYE=false
# APP_JAPAN=false
# APP_DRYRUN=false

# License verification (disable in production)
# LICENSE_VALIDATION_ENDPOINT=

# Import batch size (legacy)
# IMPORT_BATCH_SIZE=9993

# Redis enabled flag (legacy)
# REDIS_ENABLED=false

# Database table prefix (if using shared database)
# DB_TABLES_PREFIX=mailing_

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
