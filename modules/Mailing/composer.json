    "autoload": {
        "psr-4": {
            "Modules\\Mailing\\": "app/",
            "Modules\\Mailing\\Providers\\": "providers/",
            "Modules\\Mailing\\Database\\Factories\\": "database/factories/",
            "Modules\\Mailing\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/namespaced_helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Mailing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Mailing\\Providers\\MailingServiceProvider"
            ]
        }
    }
}
