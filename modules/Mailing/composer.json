    "require-dev": {
        "doctrine/instantiator": "^1.3.1",
        "fideloper/proxy": "^4.0",
        "mockery/mockery": "^1.0",
        "pestphp/pest": "^1.23",
        "phpunit/php-code-coverage": "^9.0",
        "phpunit/phpunit": "^9.5",
        "sebastian/global-state": "^5.0"
