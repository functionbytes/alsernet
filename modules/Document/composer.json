{
    "name": "modules/document",
    "description": "Document Management Module - PDF generation, Excel export, validation workflows",
    "keywords": ["documents", "pdf", "excel", "export", "validation"],
    "authors": [
        {
            "name": "Alsernet Development",
            "email": "dev@alsernet.com"
        }
    ],
    "require": {
        "barryvdh/laravel-dompdf": "^3.1",
        "barryvdh/laravel-ide-helper": "^3.6",
        "maatwebsite/excel": "^3.1",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "setasign/fpdi-tcpdf": "^2.3",
        "soundasleep/html2text": "~1.1",
        "ezyang/htmlpurifier": "^4.17"
    },
    "extra": {
        "laravel": {
            "providers": [],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Document\\": "app/",
            "Modules\\Document\\Database\\Factories\\": "database/factories/",
            "Modules\\Document\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Document\\Tests\\": "tests/"
        }
    }
}
