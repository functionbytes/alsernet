{
    "name": "modules/mails-settings",
    "description": "Mail Settings Module - SMTP configuration, IMAP integration, incoming/outgoing email management",
    "keywords": ["mail", "smtp", "imap", "email", "settings"],
    "authors": [
        {
            "name": "Alsernet Development",
            "email": "dev@alsernet.com"
        }
    ],
    "require": {
        "webklex/laravel-imap": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "extra": {
        "laravel": {
            "providers": [],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\MailsSettings\\": "app/",
            "Modules\\MailsSettings\\Database\\Factories\\": "database/factories/",
            "Modules\\MailsSettings\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\MailsSettings\\Tests\\": "tests/"
        }
    }
}
