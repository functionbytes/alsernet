{% comment %}
  Alsernet Live Chat — App Embed Block
  ----------------------------------------
  Loads the Alsernet engagement SDK on every page of the storefront.
  Cart and customer detection use Shopify's native globals; the
  ShopifyAdapter inside the SDK reads them automatically.
{% endcomment %}

{% if block.settings.api_url != blank and block.settings.website_token != blank %}
<script>
(function(w,d){
    w.chat = w.chat || function(){(w.chat.q=w.chat.q||[]).push(arguments);};
})(window,document);
</script>
<script async src="{{ block.settings.api_url | strip | append: '/build-engagement/sdk.js' }}"></script>
<script>
window.chat('init', {
    token: {{ block.settings.website_token | json }},
    apiUrl: {{ block.settings.api_url | strip | json }},
    consent: true
});
{% if customer %}
window.chat('identify', {
    id: {{ customer.id | json }},
    email: {{ customer.email | json }},
    name: {{ customer.name | json }},
    phone: {{ customer.phone | json }}
});
{% endif %}
</script>
{% endif %}

{% schema %}
{
  "name": "Alsernet Chat",
  "target": "head",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "URL de la API",
      "default": "https://panel.alsernet.com",
      "info": "Sin barra final. Ej: https://panel.alsernet.com"
    },
    {
      "type": "text",
      "id": "website_token",
      "label": "Website token",
      "info": "Token del canal Web del inbox del Helpdesk."
    }
  ]
}
{% endschema %}
