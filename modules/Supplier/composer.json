    "keywords": ["supplier", "sourcing", "automation", "ai", "content"],
    "authors": [
        {
            "name": "Alsernet Development",
            "email": "dev@alsernet.com"
        }
    ],
    "require": {
        "deeplcom/deepl-php": "^1.11",
        "guzzlehttp/guzzle": "^7.0",
        "kriswallsmith/buzz": "^1.3",
